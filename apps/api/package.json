{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "prebuild": "rm -rf dist",
    "clean": "rm -rf dist",
    "start": "dotenv -e ../../.env -- node dist/index.cjs",
    "dev": "dotenv -e ../../.env -- tsup --watch --onSuccess \"node dist/index.cjs\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "dotenv -e ../../.env -- jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/tokens": "workspace:*",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "4.21.2",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "tsup": "^8.4.0",
    "typescript": "5.8.2"
  }
}
