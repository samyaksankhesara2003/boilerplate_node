{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "make-migration": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' knex migrate:make --knexfile=./src/knexfile.ts",
    "migrate": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' knex migrate:latest --knexfile=./src/knexfile.ts",
    "make-seed": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' knex seed:make --knexfile=./src/knexfile.ts",
    "run-seed": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' knex seed:run --knexfile=./src/knexfile.ts",
    "rollback": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' knex migrate:rollback --knexfile=./src/knexfile.ts",
    "clear-db": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' knex migrate:rollback --all --knexfile=./src/knexfile.ts"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "knex": "^3.1.0",
    "mysql": "^2.18.1",
    "objection": "^3.1.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.14.0",
    "bunchee": "^6.4.0",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2"
  }
}
